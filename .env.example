# ==========================================
# Empty Bottle - Environment Configuration
# ==========================================

# --- Backend Configuration (Express / Render) ---
# Server listening port (default: 3000)
PORT=3000

# Server environment mode ('development' or 'production')
NODE_ENV=development

# Allowed CORS origin for standalone frontend deployment (e.g. Vercel)
# Use '*' for development or your Vercel URL in production (e.g., https://empty-bottle.vercel.app)
CORS_ORIGIN=*

# Supabase PostgreSQL Configuration (for future persistence phase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (Never expose in frontend!)

# Gemini AI API Configuration (for future AI Assistant phase)
# Required for Gemini AI API calls. Server-side only.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Application hosting URL (optional, set by cloud host)
APP_URL=http://localhost:3000

# --- Frontend Configuration (Vite / Vercel) ---
# Base URL for API calls. If blank or relative, Vite proxies to same origin.
# When deploying frontend on Vercel and backend on Render, set this to your Render backend URL:
# VITE_API_BASE_URL=https://empty-bottle-api.onrender.com
VITE_API_BASE_URL=
